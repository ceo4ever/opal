{
  "commands": [
    {
      "name": "MAMS: Start BE dev",
      "description": "FastAPI 백엔드 서버 Surface 기동 (uvicorn --reload)",
      "keywords": ["be", "backend", "start", "uvicorn"],
      "command": "bash .opal/cmux/scripts/open-dev.sh be",
      "confirm": false
    },
    {
      "name": "MAMS: Start FE dev",
      "description": "Next.js 프론트엔드(본) Surface 기동",
      "keywords": ["fe", "frontend", "start", "next"],
      "command": "bash .opal/cmux/scripts/open-dev.sh fe",
      "confirm": false
    },
    {
      "name": "MAMS: Start FE wireframe",
      "description": "Next.js 프론트엔드(와이어프레임 참조) Surface 기동",
      "keywords": ["fe-wire", "wireframe", "start"],
      "command": "bash .opal/cmux/scripts/open-dev.sh fe-wire",
      "confirm": false
    },
    {
      "name": "MAMS: Start FE test",
      "description": "Next.js 프론트엔드(API 테스트) Surface 기동",
      "keywords": ["fe-test", "test", "start"],
      "command": "bash .opal/cmux/scripts/open-dev.sh fe-test",
      "confirm": false
    },
    {
      "name": "MAMS: Start Batch (Airflow)",
      "description": "Airflow Docker Compose Surface 기동",
      "keywords": ["batch", "airflow", "docker", "start"],
      "command": "bash .opal/cmux/scripts/open-dev.sh batch",
      "confirm": false
    },
    {
      "name": "MAMS: Start All",
      "description": "BE + FE + Batch Surface 전체 일괄 기동",
      "keywords": ["start", "all", "전체"],
      "command": "bash .opal/cmux/scripts/start-all.sh",
      "confirm": true
    },
    {
      "name": "MAMS: Stop All",
      "description": "모든 MAMS Surface 일괄 종료 + Airflow docker compose down",
      "keywords": ["stop", "all", "종료"],
      "command": "bash .opal/cmux/scripts/stop-all.sh",
      "confirm": true
    },
    {
      "name": "MAMS: Stop Batch",
      "description": "Airflow Docker Compose 종료만 수행",
      "keywords": ["stop", "batch", "airflow", "down"],
      "command": "cd workspace/backend && docker compose -f docker-compose.airflow.yml down",
      "confirm": true
    },
    {
      "name": "MAMS: Open Swagger",
      "description": "백엔드 Swagger UI 브라우저 분할 오픈",
      "keywords": ["swagger", "api", "docs", "browser"],
      "command": "cmux browser open-split http://localhost:8000/docs",
      "confirm": false
    },
    {
      "name": "MAMS: Open Next dev",
      "description": "FE 개발 서버 브라우저 분할 오픈",
      "keywords": ["frontend", "browser", "next", "3000"],
      "command": "cmux browser open-split http://localhost:3000",
      "confirm": false
    },
    {
      "name": "MAMS: Open Airflow UI",
      "description": "Airflow 웹 UI 브라우저 분할 오픈",
      "keywords": ["airflow", "ui", "browser", "8080"],
      "command": "cmux browser open-split http://localhost:8080",
      "confirm": false
    },
    {
      "name": "MAMS: Open wireframe compare",
      "description": "FE(본) + FE-wire(와이어프레임) 좌우 브라우저 비교",
      "keywords": ["wireframe", "compare", "split"],
      "workspace": {
        "layout": "split-horizontal",
        "surfaces": [
          { "name": "fe-browser", "command": "cmux browser open-split http://localhost:3000" },
          { "name": "wire-browser", "command": "cmux browser open-split http://localhost:3001" }
        ]
      }
    },
    {
      "name": "MAMS: Analyze BE log (last 5 min)",
      "description": "백엔드 최신 로그에서 ERROR/Traceback/structlog 이벤트 추출",
      "keywords": ["log", "error", "analyze", "backend"],
      "command": "bash .opal/cmux/scripts/analyze-log.sh be --minutes 5",
      "confirm": false
    },
    {
      "name": "MAMS: Show Airflow password",
      "description": "Airflow admin 초기 비밀번호 확인",
      "keywords": ["airflow", "password", "admin"],
      "command": "cd workspace/backend && docker compose -f docker-compose.airflow.yml exec airflow-apiserver cat /opt/airflow/simple_auth_manager_passwords.json.generated",
      "confirm": false
    },
    {
      "name": "MAMS: Test browser (URL)",
      "description": "브라우저 A/B/C 분기 러너 — URL을 인자로 추가 입력",
      "keywords": ["test", "browser", "e2e", "url"],
      "command": "bash .opal/cmux/scripts/test-browser.sh",
      "confirm": false
    }
  ]
}
