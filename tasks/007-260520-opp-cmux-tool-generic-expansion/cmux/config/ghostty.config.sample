# MAMS cmux Ghostty 설정 예시
# 수동 적용: cp .opal/cmux/config/ghostty.config.sample ~/.config/ghostty/config
#
# 주의: 이 파일은 샘플입니다. ~/.config/ghostty/config 전역 파일은
#       이 스크립트/워커가 직접 수정하지 않습니다. 수동으로 복사·적용하세요.
#
# Ghostty 공식 문서: https://ghostty.org/docs/config
# cmux 설정 문서: https://cmux.com/docs/configuration (2026-04-18 기준)

# ─── 폰트 ────────────────────────────────────────────────────────────────────
# 한글 지원 Nerd Font 예시 — 설치: brew install font-d2coding-nerd-font
font-family = D2Coding Nerd Font
font-size = 13

# ─── 테마 ────────────────────────────────────────────────────────────────────
# 다크 테마 예시 (Ghostty 내장 테마 목록: ghostty +list-themes)
theme = GruvboxDark

# ─── 커서 ────────────────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = true

# ─── 스크롤백 ─────────────────────────────────────────────────────────────────
scrollback-limit = 10000

# ─── 투명도 (선택) ────────────────────────────────────────────────────────────
# background-opacity = 0.95

# ─── MAMS 친화 키바인딩 ──────────────────────────────────────────────────────
# 전체화면 전환
keybind = cmd+shift+enter=toggle_fullscreen

# 새 탭
keybind = cmd+t=new_tab

# 탭 이동 (⌘1~8 — cmux Surface 단축키와 충돌하지 않도록 조정 필요)
# cmux 기본 단축키가 우선하므로 아래는 참고용
# keybind = cmd+1=goto_tab:1
# keybind = cmd+2=goto_tab:2

# 폰트 크기 조절
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# ─── 기타 ────────────────────────────────────────────────────────────────────
# 터미널 종료 시 확인 프롬프트
confirm-close-surface = true

# 클립보드 접근 허용 (cmux notify/hooks 연동 시 필요할 수 있음)
clipboard-read = allow
clipboard-write = allow
