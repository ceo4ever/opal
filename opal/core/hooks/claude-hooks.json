{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.opal/.venv/bin/python\" \"$HOME/.opal/tools/ownership-tool/ownership_tool/session_start_hook.py\""
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Edit|Write|NotebookEdit|Bash",
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.opal/.venv/bin/python\" \"$HOME/.opal/tools/ownership-tool/ownership_tool/pretooluse_guard_hook.py\""
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.opal/.venv/bin/python\" \"$HOME/.opal/tools/state-tool/todo_mirror_hook.py\""
        }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$HOME/.opal/tools/code-scan/code-map-hook.js\""
        }
      ]
    },
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.opal/.venv/bin/python\" \"$HOME/.opal/tools/ownership-tool/ownership_tool/heartbeat_hook.py\""
        }
      ]
    }
  ],
  "SubagentStop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "osascript -e 'display notification \"서브에이전트 작업이 완료되었습니다\" with title \"Claude Code\" sound name \"Glass\"'"
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.opal/.venv/bin/python\" \"$HOME/.opal/tools/ownership-tool/ownership_tool/stop_hook.py\""
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.opal/.venv/bin/python\" \"$HOME/.opal/tools/ownership-tool/ownership_tool/session_end_hook.py\""
        }
      ]
    }
  ]
}
