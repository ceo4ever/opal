{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OPAL state.json Schema",
  "description": "state-tool이 관리하는 파이프라인 현황판 JSON. PLAN §2.2 G-1~G-4 SSOT.",
  "type": "object",
  "required": ["task_id", "skill", "mode", "schema_version", "created_at", "updated_at", "current_status", "rows"],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[0-9]{6}-[a-z]+-.*$",
      "description": "태스크 폴더명 (예: 134-260501-opp-pipeline-state-tool)"
    },
    "skill": {
      "enum": ["opp", "opd", "opds", "opdw", "opwt", "opgc", "oppd", "opsdd"],
      "description": "오케스트레이터 스킬 약어 — opal-pilot-* 8종"
    },
    "mode": {
      "enum": ["interactive", "agentic"],
      "description": "OPAL 실행 모드"
    },
    "schema_version": {
      "const": "1.0",
      "description": "스키마 버전 — 신규 enum 추가 시 1.1로 올림"
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$",
      "description": "state.json 최초 생성 시점 (KST YYYY-MM-DD HH:mm)"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$",
      "description": "마지막 갱신 시점 (KST YYYY-MM-DD HH:mm)"
    },
    "current_status": {
      "enum": ["in_progress", "done", "blocked", "additional_work", "additional_work_done"],
      "description": "태스크 전체 상태 — §2.11 G-7 전이 그래프 참조"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "description": "파이프라인 현황판 행 목록 — row_id 1-based 단조 증가",
      "items": {
        "type": "object",
        "required": ["row_id", "stage", "item", "status", "status_label", "timestamp"],
        "additionalProperties": false,
        "properties": {
          "row_id": {
            "type": "integer",
            "minimum": 1,
            "description": "행 번호 (1-based, 단조 증가 — add-row 시 재정렬)"
          },
          "stage": {
            "enum": [
              "TASK", "ANALYSIS", "PLAN", "EXECUTE", "TEST",
              "WIREFRAME", "QA", "SPEC", "REVIEW", "DESIGN",
              "VERIFY", "SCAN", "CHECK", "REPORT", "WBS", "CLOSE"
            ],
            "description": "단계명 — 8개 opal-pilot SKILL.md 합집합 16종 (G-3)"
          },
          "item": {
            "type": "string",
            "minLength": 1,
            "description": "행 항목명. 표준 항목(STANDARD_ITEMS) 또는 산출물명 자유 string"
          },
          "status": {
            "enum": ["pending", "in_progress", "done", "failed", "na"],
            "description": "행 상태 enum (T-2) — status_label과 정합 필수"
          },
          "status_label": {
            "enum": ["⬜", "🔄", "✅", "❌", "-"],
            "description": "행 상태 이모지 (T-2) — status와 정합 필수"
          },
          "timestamp": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "행 갱신 시점 (KST). pending 행은 null 허용, 그 외 상태는 string 필수"
          },
          "owner": {
            "oneOf": [
              {"enum": ["PM", "worker", "user", "auto"]},
              {"type": "null"}
            ],
            "description": "갱신 주체 — G-12 참조"
          },
          "note": {
            "oneOf": [
              {"type": "string"},
              {"type": "null"}
            ],
            "description": "행 메모 — auto-pass / force / block 이유 등"
          }
        }
      }
    }
  }
}
