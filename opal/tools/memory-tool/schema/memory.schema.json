{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "opal://memory-tool/memory.schema.json",
  "title": "OPAL Memory Document",
  "description": "MEMORY.json 문서 스키마 (SSOT). memory_tool.py는 런타임에 이 파일을 로드해 enum·제약을 파생한다 (078 문서 스키마 전환).",
  "type": "object",
  "required": ["version", "last_task_number", "memories", "history"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "문서 스키마 버전"
    },
    "last_task_number": {
      "type": "integer",
      "minimum": 0,
      "description": "마지막 발급 태스크 번호"
    },
    "memories": {
      "type": "array",
      "items": { "$ref": "#/$defs/memoryRow" },
      "description": "메모리 인덱스 행 목록"
    },
    "history": {
      "type": "array",
      "items": { "$ref": "#/$defs/historyRow" },
      "description": "작업 히스토리 행 목록 (FIFO=x-constants.HISTORY_FIFO_LIMIT, 맨 앞=최신)"
    }
  },
  "$defs": {
    "memoryRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "date", "type", "status", "file", "summary"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "짧은 명사구. 스캔 1순위 키. 상한은 x-advisory.TITLE_MAX_LENGTH 참조(강제 아님)."
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "등록일 YYYY-MM-DD (KST)"
        },
        "type": {
          "type": "string",
          "enum": ["project", "architecture", "feedback", "preferences", "issues", "task", "improvement"],
          "description": "메모리 유형 enum (memory_tool.py VALID_TYPES와 정확히 일치)"
        },
        "status": {
          "type": "string",
          "enum": ["active", "promoted", "superseded", "dead", "candidate"],
          "description": "라이프사이클 상태 enum (memory_tool.py VALID_STATUSES와 정확히 일치)"
        },
        "file": {
          "type": "string",
          "pattern": "^memory/[^/].*\\.md$",
          "description": "memory/<name>.md 상대경로 포인터"
        },
        "summary": {
          "type": "string",
          "maxLength": 80,
          "description": "요약 ≤80자 1줄 [MUST]. 상세는 개별 .md 본문 전용."
        }
      }
    },
    "historyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "date", "stage", "path", "result"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "태스크 명사구(맨 앞). 상한은 x-advisory.TITLE_MAX_LENGTH 참조(강제 아님)."
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "등록일 YYYY-MM-DD (TASK 시작일, KST)"
        },
        "stage": {
          "type": "string",
          "description": "단계. 진행중: 'PLAN ✅ → TODO 대기' / 완료: '완료'"
        },
        "path": {
          "type": "string",
          "description": "tasks/<폴더>/ 상대경로"
        },
        "result": {
          "type": "string",
          "description": "핵심결과 [MUST]. 무엇을 바꿨는지 + 결과. 줄 수 상한은 x-advisory.RESULT_MAX_LINES 참조(강제 아님)."
        }
      }
    }
  },
  "x-constants": {
    "HISTORY_FIFO_LIMIT": 5,
    "SUMMARY_MAX_LENGTH": 80,
    "PROMOTE_AGE_DAYS": 30,
    "CURRENT_VERSION": 1
  },
  "x-advisory": {
    "TITLE_MAX_LENGTH": 30,
    "RESULT_MAX_LINES": 2,
    "HISTORY_MAX_ITEMS": 5,
    "_note": "강제하면 실 데이터가 즉시 거부되므로 review.violations 권고로만 표면화한다 (강제하지 않음)."
  }
}
