{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OPAL test-scenario.json Schema",
  "description": "test-tool scenario-* SSOT with E2E profile/verdict v2 fields.",
  "type": "object",
  "required": ["schema_version", "task_id", "locked", "created_at", "locked_at", "scenarios"],
  "additionalProperties": false,
  "definitions": {
    "handoffSpec": {
      "type": "object",
      "required": [
        "handoff_id",
        "instruction",
        "expected_observation",
        "required_evidence",
        "timeout_seconds",
        "resume_token",
        "server_policy",
        "submission_path"
      ],
      "additionalProperties": true,
      "properties": {
        "handoff_id": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "expected_observation": {"type": "string", "minLength": 1},
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "timeout_seconds": {"type": "number"},
        "resume_token": {"type": "string", "minLength": 1},
        "server_policy": {"type": "string", "minLength": 1},
        "submission_path": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {
      "enum": ["1.0", "2.0"]
    },
    "task_id": {
      "type": "string"
    },
    "locked": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string"
    },
    "locked_at": {
      "type": ["string", "null"]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "acceptance_ref",
          "type",
          "expected",
          "red_required",
          "red_confirmed",
          "red_evidence",
          "red_at",
          "required_fidelity",
          "surface_ref",
          "surface_kind",
          "profile",
          "actors",
          "steps",
          "assertions",
          "required_evidence",
          "handoff",
          "result",
          "operational_status",
          "observed_executors",
          "assertion_results",
          "observed_evidence",
          "handoff_state",
          "evidence",
          "marked_at",
          "fidelity"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9A-Za-z-]*$"
          },
          "acceptance_ref": {
            "type": ["string", "null"]
          },
          "type": {
            "enum": ["unit", "integration", "contract", "regression", "e2e"]
          },
          "expected": {
            "type": ["string", "null"]
          },
          "red_required": {
            "type": "boolean"
          },
          "red_confirmed": {
            "type": "boolean"
          },
          "red_evidence": {
            "type": ["string", "null"]
          },
          "red_at": {
            "type": ["string", "null"]
          },
          "required_fidelity": {
            "enum": ["mock", "real-http", "real-usage"]
          },
          "surface_ref": {
            "type": ["string", "null"]
          },
          "surface_kind": {
            "type": ["string", "null"],
            "enum": ["web_ui", "api", "hybrid", "collaborative", "manual", null]
          },
          "profile": {
            "type": ["string", "null"],
            "enum": ["browser", "api", "hybrid", "collaborative", "manual", null]
          },
          "actors": {
            "type": "array",
            "items": {"type": "string"}
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "executor"],
              "additionalProperties": true,
              "properties": {
                "id": {"type": "string"},
                "executor": {"enum": ["browser", "api", "human"]}
              }
            }
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "expected"],
              "additionalProperties": true,
              "properties": {
                "id": {"type": "string"},
                "expected": {}
              }
            }
          },
          "required_evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "handoff": {
            "anyOf": [
              {"$ref": "#/definitions/handoffSpec"},
              {"type": "null"}
            ]
          },
          "result": {
            "type": ["string", "null"],
            "enum": ["pass", "fail", "blocked", "infra_error", "executor_unavailable", null]
          },
          "operational_status": {
            "type": ["string", "null"],
            "enum": ["awaiting_human", null]
          },
          "observed_executors": {
            "type": "array",
            "items": {"enum": ["browser", "api", "human"]}
          },
          "assertion_results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "id": {"type": "string"},
                "expected": {},
                "actual": {}
              }
            }
          },
          "observed_evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "handoff_state": {
            "anyOf": [
              {"$ref": "#/definitions/handoffSpec"},
              {"type": "null"}
            ]
          },
          "run_id": {
            "type": ["string", "null"]
          },
          "evidence": {
            "type": ["string", "null"]
          },
          "marked_at": {
            "type": ["string", "null"]
          },
          "fidelity": {
            "enum": ["mock", "real-http", "real-usage"]
          }
        }
      }
    }
  }
}
